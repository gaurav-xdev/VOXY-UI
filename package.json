{
  "name": "voxy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node --env-file-if-exists=.env dist-server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:server": "vitest run tests/server",
    "test:client": "vitest run tests/client",
    "verify:build": "node scripts/verify-build.mjs",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run build && npm run verify:build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@node-rs/argon2": "^2.2.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@tanstack/react-query": "^5.104.0",
    "@types/three": "^0.185.3",
    "clsx": "2.1.1",
    "fastify": "^5.12.5",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^8.4.0",
    "stripe": "^23.0.0",
    "tailwind-merge": "3.4.0",
    "three": "^0.185.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.1.17",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.19.17",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "concurrently": "^9.2.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "tailwindcss": "4.1.17",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
