# ──────────────────────────────────────────────────────────────────────────────
# VOXY environment configuration. COPY to `.env` (git-ignored). NEVER commit real values.
#
# Every variable below is SERVER-ONLY. The browser bundle contains no environment values:
# the SPA only receives what GET /api/config/public explicitly returns (company/legal info,
# billing on/off). There are no VITE_* secrets and none should ever be added.
#
# DEPLOY_ENV separates environments. `staging` and `production` are HARDENED: the server
# refuses to start if a required value is missing or unsafe (fail closed).
# ──────────────────────────────────────────────────────────────────────────────

# development | test | staging | production
DEPLOY_ENV=development

# Public origin users type in the browser (scheme + host, no path). Drives cookie flags
# (https ⇒ Secure + __Host- prefixed cookies), CSRF Origin checks, email links, Stripe return URLs.
# staging/production MUST be https.
APP_URL=http://localhost:5173

HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# Reverse-proxy hops in front of the app that you control (load balancer, CDN…).
# 0 = trust no X-Forwarded-For (every client appears as the proxy IP, which would also make
# per-IP rate limits shared by ALL users, so set the real hop count in production).
TRUST_PROXY_HOPS=0

# ── Database ──────────────────────────────────────────────────────────────────
# development default: embedded PGlite in ./.data (no setup). staging/production need Postgres:
#   DATABASE_URL=postgres://user:password@host:5432/voxy
DATABASE_URL=pglite://./.data/dev
DATABASE_POOL_MAX=10
# TLS to Postgres. Only "disable" for a private network you trust.
DATABASE_SSL=require
# Run pending SQL migrations at boot (dev default true). In production prefer false and run
# migrations as a deploy step; the server then refuses to start on a stale schema.
# AUTO_MIGRATE=false

# ── Secrets (≥ 32 random chars; e.g. `openssl rand -base64 48`) ───────────────
# Signs CSRF tokens and device cookies. Required in staging/production. Rotating it signs
# everyone out of "trusted device" status and invalidates outstanding CSRF tokens (not sessions).
# APP_SECRET=

# ── Sessions ──────────────────────────────────────────────────────────────────
SESSION_ABSOLUTE_TTL_HOURS=720
SESSION_IDLE_TTL_HOURS=168
REAUTH_WINDOW_MINUTES=10

# ── Email (verification + password reset). Required in staging/production ─────
# SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM="VOXY <no-reply@example.com>"

# ── Billing (Stripe). Leave unset to run with billing disabled ────────────────
# STRIPE_SECRET_KEY=sk_live_or_test_...        (server only)
# STRIPE_WEBHOOK_SECRET=whsec_...              (endpoint: POST {APP_URL}/api/webhooks/stripe)
# Plans: price IDs are resolved on the server; the browser only sends the plan key.
# BILLING_PLANS_JSON=[{"key":"pro","label":"VOXY Pro","priceId":"price_..."}]
BILLING_PAST_DUE_GRACE_DAYS=3

# ── Legal / company info shown on the legal pages (nothing is invented if unset) ─
# LEGAL_COMPANY_NAME=
# LEGAL_COMPANY_ADDRESS=
# LEGAL_REGISTRATION_NUMBER=
# LEGAL_CONTACT_EMAIL=
# LEGAL_SUPPORT_EMAIL=
# LEGAL_PRIVACY_EMAIL=
# LEGAL_JURISDICTION=
# LEGAL_EFFECTIVE_DATE=2026-01-01
# Keep "false" until the business/legal owner has reviewed the legal pages; while false, every
# legal page shows a visible "Draft — pending review" notice.
LEGAL_REVIEWED=false
# SECURITY_CONTACT_EMAIL=
